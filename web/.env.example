# Desiora AI - Next.js Web App Environment Variables

# API Configuration
# Backend API base URL
NEXT_PUBLIC_API_URL=http://localhost:8000

# Google OAuth Configuration
# Get your Google Client ID from: https://console.cloud.google.com/apis/credentials
# Create OAuth 2.0 Client ID and add authorized redirect URI: http://localhost:3000/auth/callback?provider=google
NEXT_PUBLIC_GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com

# Optional: Apple OAuth (if implementing Apple Sign In)
# NEXT_PUBLIC_APPLE_CLIENT_ID=your-apple-client-id

# Optional: Environment (development, staging, production)
# NODE_ENV=development
